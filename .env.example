APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
SAIL_SERVICE=salas

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Em produção,depende de Supervisor instalado para processar a fila.
# Em ambiente dev, pode subir um processo com
# php artisan queue:listen
# ou usar
# QUEUE_CONNECTION=sync
QUEUE_CONNECTION=database

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SENHAUNICA_KEY=
SENHAUNICA_SECRET=
SENHAUNICA_CALLBACK_ID=

REPLICADO_HOST=
REPLICADO_PORT=
REPLICADO_DATABASE=
REPLICADO_USERNAME=
REPLICADO_PASSWORD=
REPLICADO_CODUNDCLG=
REPLICADO_SYBASE=

SENHAUNICA_ADMINS=

# SENHAUNICA-SOCIALITE ######################################
# https://github.com/uspdev/senhaunica-socialite

# URL do servidor oauth no ambiente de dev (default=no)
#SENHAUNICA_DEV="https://dev.uspdigital.usp.br/wsusuario/oauth"

# URL do servidor oauth para uso com senhaunica-faker
#SENHAUNICA_DEV="http://127.0.0.1:3141/wsusuario/oauth"

# Desabilite para não salvar o retorno do oauth em storage/app/debug/oauth/ (default=true)
#SENHAUNICA_DEBUG=

# AS CONFIGURAÇÕES A SEGUIR são relevantes se permission=true

# Esses usuários terão privilégios especiais
#SENHAUNICA_ADMINS=11111,22222,33333
#SENHAUNICA_GERENTES=4444,5555,6666

# Se os logins forem limitados a usuários cadastrados (onlyLocalUsers=true),
# pode ser útil cadastrá-los aqui.
#SENHAUNICA_USERS=777,888

# Se true, os privilégios especiais serão revogados ao remover da lista (default=false)
#SENHAUNICA_DROP_PERMISSIONS=

# Código da unidade para identificar os logins próprios ou de outras unidades
SENHAUNICA_CODIGO_UNIDADE=

USP_THEME_SKIN=fflch

# LARAVEL TOOLS #########################################
# https://github.com/uspdev/laravel-tools

# Se sua aplicação está atrás de um proxy e se comunica com o proxy por http mas o proxy
# se comunica com o usuário por https, vc deve forçar o https no laravel (default = false).
#LARAVEL_TOOLS_FORCAR_HTTPS=false

# Ativa mensagens de debug (default = app.debug)
#LARAVEL_TOOLS_DEBUG=

# Campos extras ao solicitar reserva
# Se estiver preenchido, eles serão exibidos ao solicitar reserva, e serão de preenchimento obrigatório
# Colocar os campos entre aspas e separados por vírgula, por exemplo: RESERVA_CAMPOS_EXTRAS="Campo 1,Campo 2,Campo 3"
RESERVA_CAMPOS_EXTRAS=

# se true, todo e-mail enviado será copiado para o endereço remetente do próprio sistema
# Colocar true para fazer essa cópia; colocar false ou deixar em branco ou comentado ou ausente para não fazer essa cópia
MAIL_COPIAR_REMETENTE=

# API CONFIGURATION ########################################
# https://docs.anthropic.com/claude-code

# API General Settings
API_PREFIX=v1
API_TOKEN_NAME=salas-api-token
API_INCLUDE_DEBUG_INFO=false
API_DEFAULT_PER_PAGE=15
API_MAX_PER_PAGE=100

# Sanctum Token Settings
SANCTUM_TOKEN_NAME=salas-api-token
SANCTUM_TOKEN_ABILITIES=api:read,api:write
SANCTUM_TOKEN_EXPIRATION_MINUTES=

# Rate Limiting Configuration
# Valores padrão baseados na configuração atual do sistema

# Authentication Endpoints - Mais restritivo para segurança
API_RATE_LIMIT_AUTH_GENERAL_ATTEMPTS=20
API_RATE_LIMIT_AUTH_GENERAL_DECAY=1
API_RATE_LIMIT_AUTH_EMAIL_ATTEMPTS=5
API_RATE_LIMIT_AUTH_EMAIL_DECAY=1
API_RATE_LIMIT_AUTH_HOURLY_ATTEMPTS=50
API_RATE_LIMIT_AUTH_HOURLY_DECAY=60

# API Authenticated Users - Limites equilibrados para usuários autenticados
API_RATE_LIMIT_API_AUTH_ATTEMPTS=100
API_RATE_LIMIT_API_AUTH_DECAY=1
API_RATE_LIMIT_API_AUTH_HOURLY_ATTEMPTS=2000
API_RATE_LIMIT_API_AUTH_HOURLY_DECAY=60

# API Guest Users - Limites mais baixos para usuários não autenticados
API_RATE_LIMIT_API_GUEST_ATTEMPTS=30
API_RATE_LIMIT_API_GUEST_DECAY=1
API_RATE_LIMIT_API_GUEST_HOURLY_ATTEMPTS=500
API_RATE_LIMIT_API_GUEST_HOURLY_DECAY=60

# Public Endpoints - Endpoints públicos de consulta (salas, categorias, etc.)
API_RATE_LIMIT_PUBLIC_ATTEMPTS=60
API_RATE_LIMIT_PUBLIC_DECAY=1
API_RATE_LIMIT_PUBLIC_HOURLY_ATTEMPTS=1000
API_RATE_LIMIT_PUBLIC_HOURLY_DECAY=60

# Admin Endpoints - Operações administrativas (aprovação/rejeição)
API_RATE_LIMIT_ADMIN_ATTEMPTS=30
API_RATE_LIMIT_ADMIN_DECAY=1
API_RATE_LIMIT_ADMIN_HOURLY_ATTEMPTS=300
API_RATE_LIMIT_ADMIN_HOURLY_DECAY=60

# Reservation Endpoints - CRUD de reservas com diferentes limites por tipo de usuário

# Usuários regulares
API_RATE_LIMIT_RESERVATIONS_USER_ATTEMPTS=30
API_RATE_LIMIT_RESERVATIONS_USER_DECAY=1
API_RATE_LIMIT_RESERVATIONS_USER_HOURLY_ATTEMPTS=500
API_RATE_LIMIT_RESERVATIONS_USER_HOURLY_DECAY=60

# Usuários bulk (para importação em massa)
API_RATE_LIMIT_RESERVATIONS_BULK_ATTEMPTS=60
API_RATE_LIMIT_RESERVATIONS_BULK_DECAY=1
API_RATE_LIMIT_RESERVATIONS_BULK_HOURLY_ATTEMPTS=500
API_RATE_LIMIT_RESERVATIONS_BULK_HOURLY_DECAY=60
API_RATE_LIMIT_RESERVATIONS_BULK_DAILY_ATTEMPTS=2000
API_RATE_LIMIT_RESERVATIONS_BULK_DAILY_DECAY=1440

# Consultas públicas de reservas (sem auth)
API_RATE_LIMIT_RESERVATIONS_GUEST_ATTEMPTS=20
API_RATE_LIMIT_RESERVATIONS_GUEST_DECAY=1
API_RATE_LIMIT_RESERVATIONS_GUEST_HOURLY_ATTEMPTS=200
API_RATE_LIMIT_RESERVATIONS_GUEST_HOURLY_DECAY=60

# Roles que têm acesso a limites mais altos para operações em massa
API_RATE_LIMIT_RESERVATIONS_BULK_ROLES=bulk-importer,system-integration,admin

# Bulk Operations - Operações dedicadas para processamento em lote
API_RATE_LIMIT_BULK_ATTEMPTS=100
API_RATE_LIMIT_BULK_DECAY=1
API_RATE_LIMIT_BULK_HOURLY_ATTEMPTS=1000
API_RATE_LIMIT_BULK_HOURLY_DECAY=60
API_RATE_LIMIT_BULK_DAILY_ATTEMPTS=5000
API_RATE_LIMIT_BULK_DAILY_DECAY=1440

# Upload Endpoints - Endpoints de upload (definido mas não usado atualmente)
API_RATE_LIMIT_UPLOADS_ATTEMPTS=10
API_RATE_LIMIT_UPLOADS_DECAY=1
API_RATE_LIMIT_UPLOADS_HOURLY_ATTEMPTS=100
API_RATE_LIMIT_UPLOADS_HOURLY_DECAY=60
API_RATE_LIMIT_UPLOADS_DAILY_ATTEMPTS=500
API_RATE_LIMIT_UPLOADS_DAILY_DECAY=1440
